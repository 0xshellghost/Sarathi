# ── Sarathi Environment Configuration ────────────────────────────
# Copy this to .env and fill in your values.
# No paid API keys required — all models are self-hosted.

# ── App ──────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── CORS (JSON array of allowed origins) ─────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Ollama — Your Self-Hosted LLM ───────────────────────────────
# Ollama serves your custom model behind an OpenAI-compatible API.
# Install: curl -fsSL https://ollama.ai/install.sh | sh
# Then create and serve your model via: ollama create sarathi-legal -f Modelfile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=sarathi-legal
OLLAMA_EMBED_MODEL=sarathi-embed
OLLAMA_TIMEOUT=120
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=3

# ── MongoDB ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sarathi

# ── ChromaDB (persistent local vector store) ─────────────────────
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=indian_legal_corpus
RAG_TOP_K=5

# ── Transcription (your custom STT model) ────────────────────────
# Point this at your STT model's HTTP endpoint.
# Leave empty to use the placeholder stub.
STT_ENDPOINT=
MAX_AUDIO_SIZE_MB=25

# ── Security ─────────────────────────────────────────────────────
INJECTION_THREAT_THRESHOLD=0.6
PII_REDACTION_ENABLED=true
